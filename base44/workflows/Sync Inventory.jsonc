{
  "description": "Every 5 minutes, pulls the Inventory Pricing tab from the Google Sheets tracker into the app's InventoryCost records so the inventory list stays in sync with the spreadsheet.",
  "name": "Sync Inventory",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Indianapolis",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_inventory",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_inventory": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncInventoryFromSheets",
            "args": {
              "scheduled": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync inventory from Google Sheets",
            "description": "Upsert InventoryCost from the Inventory Pricing tab"
          }
        }
      }
    ]
  }
}