{
  "name": "Order",
  "type": "object",
  "properties": {
    "sale_date": {
      "type": "string",
      "format": "date"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Vinted",
        "Depop",
        "Mercari",
        "Poshmark",
        "eBay",
        "Etsy",
        "Stan Store"
      ]
    },
    "order_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "size": {
      "type": "string"
    },
    "unit_price": {
      "type": "number"
    },
    "sale_total": {
      "type": "number"
    },
    "buyer": {
      "type": "string"
    },
    "source_email_id": {
      "type": "string"
    },
    "base_item_cost": {
      "type": "number"
    },
    "paper_ink_cost": {
      "type": "number"
    },
    "packaging_cost": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "estimated_profit": {
      "type": "number"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Safety/archive flag. Archived rows are excluded from all live totals."
    },
    "sync_source": {
      "type": "string",
      "description": "Where the row came from, such as google_sheet or manual"
    },
    "business_id": {
      "type": "string",
      "description": "Business workspace that owns this order"
    },
    "access_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails allowed to access this order"
    }
  },
  "required": [
    "sale_date",
    "platform",
    "product_name",
    "quantity",
    "size",
    "unit_price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.business_id": "{{user.data.active_business_id}}"
        },
        {
          "data.access_emails": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.business_id": "{{user.data.active_business_id}}"
        },
        {
          "data.access_emails": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.business_id": "{{user.data.active_business_id}}"
        }
      ]
    }
  }
}