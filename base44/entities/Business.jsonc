{
  "name": "Business",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Business or brand name"
    },
    "notes": {
      "type": "string"
    },
    "primary_email": {
      "type": "string",
      "description": "Primary owner/contact email for this business workspace"
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails allowed to access this business workspace"
    },
    "sales_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email accounts used to import marketplace sales for this business"
    },
    "expense_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email addresses associated with business expense purchases and connected expense inboxes"
    },
    "spreadsheet_id": {
      "type": "string",
      "description": "Google Sheets spreadsheet used as the master Art Flow Creative tracker"
    },
    "extension_sync_key": {
      "type": "string",
      "description": "Secret browser-extension key used to submit marketplace order metadata without sharing marketplace passwords or session cookies"
    },
    "extension_sync_enabled": {
      "type": "boolean",
      "description": "Whether Art Flow Browser Sync is enabled for this business"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_emails": "{{user.email}}"
        },
        {
          "data.sales_emails": "{{user.email}}"
        },
        {
          "data.expense_emails": "{{user.email}}"
        },
        {
          "data.primary_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_emails": "{{user.email}}"
        },
        {
          "data.primary_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.primary_email": "{{user.email}}"
        }
      ]
    }
  }
}