{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "default": "expense"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "amount",
    "type",
    "date"
  ]
}