{
  "name": "ArtPiece",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the artwork piece"
    },
    "description": {
      "type": "string",
      "description": "Optional notes about the piece"
    },
    "medium": {
      "type": "string",
      "description": "Medium, e.g. Gicl\u00e9e print, Original painting"
    },
    "price": {
      "type": "number",
      "description": "Listed sale price of the piece"
    },
    "status": {
      "type": "string",
      "enum": [
        "Available",
        "Reserved",
        "Sold",
        "In Progress"
      ],
      "default": "Available"
    },
    "image_url": {
      "type": "string",
      "description": "Uploaded photo of the artwork"
    }
  },
  "required": [
    "title",
    "price",
    "status"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}