{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "gmail_sales",
        "gmail_expenses",
        "outlook_sales",
        "outlook_expenses",
        "yahoo_sales",
        "yahoo_expenses",
        "vinted_api",
        "depop_api",
        "etsy_api",
        "ebay_api"
      ]
    },
    "last_synced_at": {
      "type": "string"
    },
    "last_found": {
      "type": "number"
    },
    "last_processed": {
      "type": "number"
    },
    "last_created": {
      "type": "number"
    },
    "last_remaining": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "running",
        "error"
      ]
    },
    "message": {
      "type": "string"
    },
    "cursor": {
      "type": "string",
      "description": "Opaque or numeric source cursor used to continue a paginated backfill without rescanning completed records."
    }
  },
  "required": [
    "business_id",
    "source",
    "last_synced_at",
    "status"
  ],
  "rls": {
    "read": {
      "data.business_id": "{{user.data.active_business_id}}"
    }
  }
}