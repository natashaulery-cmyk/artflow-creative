{
  "name": "InventoryCost",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for the item (used for non-frame inventory)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Frame",
        "Print",
        "Supply",
        "Packaging",
        "Other"
      ],
      "default": "Frame"
    },
    "size": {
      "type": "string",
      "description": "Frame/print size (e.g. 5x7). Used to match order cost for frames."
    },
    "image_url": {
      "type": "string",
      "description": "Uploaded photo of the artwork / item"
    },
    "base_item_cost": {
      "type": "number"
    },
    "paper_ink_cost": {
      "type": "number",
      "default": 0.09
    },
    "packaging_cost": {
      "type": "number",
      "default": 0.4
    },
    "total_unit_cost": {
      "type": "number"
    },
    "quantity_on_hand": {
      "type": "number",
      "default": 0
    },
    "low_stock_level": {
      "type": "number",
      "default": 5
    },
    "business_id": {
      "type": "string",
      "description": "Business workspace that owns this inventory item"
    },
    "access_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails allowed to access this inventory item"
    }
  },
  "required": [
    "base_item_cost",
    "quantity_on_hand"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.business_id": "{{user.data.active_business_id}}"
        },
        {
          "data.access_emails": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.business_id": "{{user.data.active_business_id}}"
        },
        {
          "data.access_emails": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.business_id": "{{user.data.active_business_id}}"
        }
      ]
    }
  }
}