{
  "name": "InventoryCost",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for the item (used for non-frame inventory)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Frame",
        "Print",
        "Supply",
        "Packaging",
        "Other"
      ],
      "default": "Frame"
    },
    "size": {
      "type": "string",
      "description": "Frame/print size (e.g. 5x7). Used to match order cost for frames."
    },
    "image_url": {
      "type": "string",
      "description": "Uploaded photo of the artwork / item"
    },
    "base_item_cost": {
      "type": "number"
    },
    "paper_ink_cost": {
      "type": "number",
      "default": 0.09
    },
    "packaging_cost": {
      "type": "number",
      "default": 0.4
    },
    "total_unit_cost": {
      "type": "number"
    },
    "quantity_on_hand": {
      "type": "number",
      "default": 0
    },
    "low_stock_level": {
      "type": "number",
      "default": 5
    }
  },
  "required": [
    "base_item_cost",
    "quantity_on_hand"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}