{
  "name": "Expense",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "monthly",
        "one-time"
      ],
      "default": "monthly"
    },
    "paid": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "amount",
    "due_date",
    "recurrence"
  ]
}