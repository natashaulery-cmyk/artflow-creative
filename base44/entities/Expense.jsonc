{
  "name": "Expense",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "enum": [
        "Inventory / Frames",
        "Printing Supplies",
        "Packaging",
        "Equipment",
        "Office Expense",
        "Software & Subscriptions",
        "Phone / Internet",
        "Advertising",
        "Shipping",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "deductible_percent": {
      "type": "number",
      "default": 100
    },
    "deductible_amount": {
      "type": "number"
    },
    "source": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Safety/archive flag. Archived rows are excluded from all live totals."
    },
    "sync_source": {
      "type": "string",
      "description": "Where the row came from, such as google_sheet or manual"
    }
  },
  "required": [
    "date",
    "category",
    "description",
    "amount"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}