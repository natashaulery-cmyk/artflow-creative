{
  "name": "Expense",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "enum": [
        "Art Materials & Supplies",
        "Paper & Print Media",
        "Ink & Printing Supplies",
        "Frames & Display",
        "Packaging & Shipping Supplies",
        "Equipment & Tools",
        "Photography Equipment",
        "Software & Subscriptions",
        "Phone / Internet",
        "Advertising & Marketing",
        "Shipping & Postage",
        "Office & Business",
        "Other Business Expense",
        "Inventory / Frames",
        "Printing Supplies",
        "Packaging",
        "Equipment",
        "Office Expense",
        "Advertising",
        "Shipping",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "deductible_percent": {
      "type": "number",
      "default": 100
    },
    "deductible_amount": {
      "type": "number"
    },
    "source": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Safety/archive flag. Archived rows are excluded from all live totals."
    },
    "sync_source": {
      "type": "string",
      "description": "Where the row came from, such as google_sheet or manual"
    },
    "business_id": {
      "type": "string",
      "description": "Business workspace that owns this expense"
    },
    "access_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails allowed to access this expense"
    },
    "auto_classified": {
      "type": "boolean",
      "description": "Whether this expense was automatically classified from email"
    },
    "confidence": {
      "type": "number",
      "description": "Automatic expense-classification confidence"
    }
  },
  "required": [
    "date",
    "category",
    "description",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.business_id": "{{user.data.active_business_id}}"
        },
        {
          "data.access_emails": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.business_id": "{{user.data.active_business_id}}"
        },
        {
          "data.access_emails": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.business_id": "{{user.data.active_business_id}}"
        }
      ]
    }
  }
}