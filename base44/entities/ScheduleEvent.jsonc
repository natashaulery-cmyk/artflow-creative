{
  "name": "ScheduleEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string",
      "description": "Optional time, e.g. 14:30"
    },
    "type": {
      "type": "string",
      "enum": [
        "Deadline",
        "Market",
        "Meeting",
        "Drop",
        "Other"
      ],
      "default": "Other"
    },
    "notes": {
      "type": "string"
    },
    "google_event_id": {
      "type": "string",
      "description": "ID of the corresponding event on the user's Google Calendar, if synced"
    }
  },
  "required": [
    "title",
    "date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}